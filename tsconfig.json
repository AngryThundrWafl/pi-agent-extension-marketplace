{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"]
  },
  "include": [
    "packages/**/*.ts",
    "scripts/**/*.mjs",
    "tests/**/*.mjs",
    "eslint.config.mjs"
  ],
  "exclude": [
    "node_modules",
    "templates",
    ".pi"
  ]
}
