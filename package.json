{
  "name": "pi-catalog",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "audit": "node scripts/audit-packages.mjs",
    "test": "node scripts/run-tests.mjs",
    "catalog:list": "node scripts/generate-catalog.mjs --list",
    "catalog:generate": "node scripts/generate-catalog.mjs",
    "catalog:check": "node scripts/generate-catalog.mjs --check",
    "new-package": "node scripts/new-package.mjs",
    "pi:install": "node scripts/install-packages.mjs",
    "verify:install": "node scripts/verify-install.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm run lint && npm run audit && npm test && npm run catalog:check && npm run verify:install"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-coding-agent": "1.6.0",
    "@earendil-works/pi-tui": "1.6.0",
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
